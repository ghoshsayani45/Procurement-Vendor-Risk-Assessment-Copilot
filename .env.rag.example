# Settings for the Week 2 RAG layer (app/rag/). Copy the lines you need into your existing .env. NEVER commit .env or a real key.

# --- shared capstone embedding API (bge-small-en-v1.5, 384 dims, max 16 texts per request, 512 tokens per text) ---
EMBED_BACKEND=endpoint
EMBED_BASE_URL=https://103.42.50.41:1035/v1
EMBED_MODEL=bge-small-en-v1.5
EMBED_API_KEY=PASTE_THE_SHARED_EMBEDDING_KEY_HERE      # different from LLM_API_KEY
EMBED_CA_BUNDLE=C:/Users/YOU/Downloads/vm02-ca.crt     # macOS/Linux: /home/you/Downloads/vm02-ca.crt  (default: ~/Downloads/vm02-ca.crt)
# EMBED_BACKEND=local                                  # fallback: local BAAI/bge-small-en-v1.5 via sentence-transformers (no server needed)

# --- retrieval ---
RAG_CHUNKING=heading            # fixed | heading | clause | window  (pick after running the chunking experiments)
RAG_TOP_BM25=20
RAG_TOP_DENSE=20
RAG_FINAL_K=6
RAG_RERANKER=cross-encoder      # cross-encoder | lexical | none
RAG_RERANKER_MODEL=BAAI/bge-reranker-base
RAG_VENDOR_FILTER=1
RAG_DEMOTE_SUPERSEDED=1

# --- generation (course endpoint: 8,192 context, 1,024 answer cap) ---
RAG_CONTEXT_WORDS=2200
RAG_MAX_ANSWER_TOKENS=700
