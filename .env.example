# Copy to .env and fill in. Never commit .env.

# Course-provided OpenAI-compatible endpoint (<=8B model) and embeddings endpoint
LLM_BASE_URL=https://REPLACE-ME/v1
LLM_API_KEY=REPLACE-ME
LLM_MODEL=REPLACE-ME
EMBED_BASE_URL=https://REPLACE-ME/v1
EMBED_MODEL=REPLACE-ME

# Per-team token quota guard (llm_client stops before the quota is exhausted)
TEAM_TOKEN_QUOTA=5000000
QUOTA_SAFETY_MARGIN=0.05
TOKEN_LEDGER_PATH=observability/token_ledger.jsonl

# PostgreSQL + pgvector (docker compose service "db")
POSTGRES_USER=pvrc
POSTGRES_PASSWORD=change-me
POSTGRES_DB=pvrc
DATABASE_URL=postgresql://pvrc:change-me@localhost:5432/pvrc

# Langfuse tracing (docker compose service "langfuse")
LANGFUSE_HOST=http://localhost:3000
LANGFUSE_PUBLIC_KEY=REPLACE-ME
LANGFUSE_SECRET_KEY=REPLACE-ME

# Review settings
REVIEW_AS_OF=2026-11-01
MAX_AGENT_STEPS=10
