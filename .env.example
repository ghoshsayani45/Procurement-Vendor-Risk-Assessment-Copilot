# Copy to .env and fill in. NEVER commit .env. Every variable the code reads is listed here.

# --- course LLM endpoint (app/llm_client.py) ---
LLM_BASE_URL=https://103.42.50.41:1033/v1    # course Qwen3-8B endpoint
LLM_MODEL=Qwen/Qwen3-8B
LLM_API_KEY=
LLM_CA_BUNDLE=certs/vm05-ca.crt    # course CA file for the LLM server (certs/ is git-ignored)
LLM_MAX_OUTPUT_TOKENS=1024         # gateway answer cap (D16)
LLM_CONTEXT_TOKENS=8192
LLM_JSON_MODE=1                    # 0 if the server rejects response_format
TEAM_TOKEN_QUOTA=                  # optional quota guard
# LLM_BACKEND=mock                 # offline stand-in for tests only

# --- shared embedding server (app/rag/embeddings.py, see .env.rag.example for retrieval settings) ---
EMBED_BACKEND=endpoint             # endpoint | local
EMBED_BASE_URL=https://103.42.50.41:1035/v1
EMBED_MODEL=bge-small-en-v1.5
EMBED_API_KEY=                     # different from LLM_API_KEY
EMBED_CA_BUNDLE=certs/vm02-ca.crt  # course CA file for the embedding server

# --- copilot app (Week 4) ---
COPILOT_LLM=none                   # none | mock | endpoint: how the copilot answers open questions (endpoint needs LLM_API_KEY)
CORPUS_PATH=data/processed/corpus_v1.jsonl   # full 1,053-document library (INSTALL.md section 4); missing file = synthetic documents only
API_RATE_LIMIT=30/minute
DATABASE_URL=                      # empty = local SQLite file; docker compose sets the Postgres URL for the api service
API_URL=                           # empty = UI runs the API in-process; docker compose sets http://api:8000
AUDIT_LOG_PATH=observability/audit_events.jsonl

# --- retrieval (app/rag/config.py; defaults shown) ---
RAG_CHUNKING=heading               # fixed | heading | clause | window
RAG_TOP_BM25=20
RAG_TOP_DENSE=20
RAG_FINAL_K=6
RAG_RERANKER=cross-encoder         # cross-encoder (needs sentence-transformers) | lexical | none
RAG_VENDOR_FILTER=1
RAG_DEMOTE_SUPERSEDED=1
EMBED_MAX_WORDS=250                # input cap for the 512-token embedding model

# --- docker compose: Postgres ---
POSTGRES_USER=pvrc
POSTGRES_PASSWORD=change-me
POSTGRES_DB=pvrc
